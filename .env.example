# Public (browser-safe) — Meridian Platform Development only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — never expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development only (never set in production)
# BOOKING_TURNSTILE_BYPASS=true
#
# Rate limiting:
# - With UPSTASH_REDIS_REST_URL + TOKEN: durable multi-instance limiter
# - Without Upstash locally: in-memory fallback (not safe across instances)
#
# Turnstile:
# - Production requires TURNSTILE_SECRET_KEY (fail closed if missing)
# - Local without secret: verification skipped (documented bypass)
