# Public (browser-safe) — Meridian Platform Development only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — never expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BOOKING_RATE_LIMIT_SECRET=

# Trusted client IP source for rate limiting / Turnstile remoteip.
# cloudflare → CF-Connecting-IP only (required when DNS is orange-cloud proxied)
# vercel → x-vercel-forwarded-for / x-real-ip
# none → do not trust X-Forwarded-For (safe default / local)
TRUSTED_PROXY=none

# Local development only (never set in production)
# BOOKING_TURNSTILE_BYPASS=true
#
# Rate limiting:
# - Production requires UPSTASH_REDIS_REST_URL + TOKEN + BOOKING_RATE_LIMIT_SECRET
#   (fail closed with a generic retry message if missing or Redis unavailable)
# - Local without Upstash: in-memory fallback (not safe across instances)
# - Identifiers are HMAC-SHA256 hashed with BOOKING_RATE_LIMIT_SECRET
#   (local/dev uses an explicit non-production default if secret is unset)
#
# Turnstile:
# - Production requires TURNSTILE_SECRET_KEY (fail closed if missing)
# - Local without secret: verification skipped (documented bypass)
# - Use separate development and production Turnstile key pairs
#
# Cloudflare edge setup (manual): see docs/cloudflare.md
